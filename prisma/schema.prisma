generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  fullName String
  email    String @unique
  password String

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())
  name String
  imageUrl String

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}
